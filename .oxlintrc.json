{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true
  },
  "ignorePatterns": [
    "!**/.server",
    "!**/.client",
    "build/",
    ".eslint-cache",
    "public/tinymce/**/*",
    "instrument.server.mjs"
  ],
  "plugins": ["react", "unicorn", "typescript", "oxc", "import", "jsx-a11y", "react-perf"],
  "rules": {
    "eslint/max-lines": ["warn", { "max": 450, "skipBlankLines": true, "skipComments": true }],
    "eslint/no-console": "error",
    "eslint/no-constant-binary-expression": "off", // Temporary disabled until code is updated.
    "eslint/no-extra-boolean-cast": "off",
    "eslint/no-fallthrough": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "message": "Importing from @mui/material barrel file hurts performance. Import from specific paths instead (e.g., @mui/material/Button).",
            "name": "@mui/material"
          }
        ]
      }
    ],
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unused-expressions": "off",
    "eslint/no-unused-vars": "error",
    "import/export": "error",
    "import/namespace": "error",
    "import/no-anonymous-default-export": "warn",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",

    "oxc/const-comparisons": "off",
    "oxc/erasing-op": "off",
    "oxc/no-barrel-file": "error",

    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",
    "react/jsx-curly-brace-presence": [1, { "children": "never", "props": "never" }],
    "react/jsx-no-target-blank": "warn",

    "typescript/no-array-constructor": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-unnecessary-type-constraint": "error",

    "typescript/triple-slash-reference": "error"
  },

  "settings": {}
}
