{
  "_comment": "Remove the boilerplate ignores (api, example, i18next/types) when starting a new project.",
  "ignore": {
    "files": [
      ".oxlintrc.json",
      "instrument.server.mjs",
      "vite.config.ts",
      "commitlint.config.cjs",
      "prettier.config.js",
      "src/api/**",
      "src/modules/example/**",
      "src/libraries/i18next/types.ts"
    ],
    "rules": ["knip/exports", "knip/types"]
  }
}
