    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/lab": "7.0.1-beta.22",
    "@mui/material": "7.3.8",
    "@posthog/react": "1.8.1",
    "@sentry/tanstackstart-react": "10.40.0",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-devtools": "0.9.6",
    "@tanstack/react-form": "1.28.3",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-query-devtools": "5.91.3",
    "@tanstack/react-router": "1.163.3",
    "@tanstack/react-router-devtools": "1.163.3",
    "@tanstack/react-router-ssr-query": "1.163.3",
    "@tanstack/react-start": "1.165.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/router-plugin": "1.164.0",
    "@zidsa/zidmui": "2.1.0",
    "i18next": "25.8.13",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "3.0.2",
    "ky": "1.14.3",
    "notistack": "3.0.2",
    "posthog-js": "1.356.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "react-i18next": "16.5.4",
    "react-query-kit": "3.3.2",
