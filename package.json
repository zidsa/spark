{
  "name": "@zidsa/spark",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "bun --env-file .env.local --preload ./instrument.server.mjs ./node_modules/.bin/vite dev --port 3000",
    "build": "vite build",
    "build:ssr": "vite build --mode ssr",
    "build:ssg": "vite build --mode ssg",
    "check:bundle": "bun scripts/check-bundle.mjs",
    "doctor": "bun scripts/check-doctor.mjs",
    "start": "bun --preload ./instrument.server.mjs ./node_modules/.bin/srvx --prod --static ../client dist/server/server.js",
    "start:ssr": "bun run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . --tsconfig tsconfig.json",
    "lint:fix": "oxlint . --tsconfig tsconfig.json --fix",
    "lint:prettier-check": "prettier --check .",
    "lint:prettier-fix": "prettier --write .",
    "tscheck": "tsc --noEmit",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "fmt:json": "prettier --check **/*.json --plugin=prettier-plugin-sort-json",
    "fmt:json:fix": "prettier --write **/*.json --plugin=prettier-plugin-sort-json",
    "fmt:css": "prettier --check **/*.css",
    "fmt:css:fix": "prettier --write **/*.css"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.9.1",
    "@mui/lab": "7.0.0",
    "@mui/material": "7.3.11",
    "@posthog/react": "1.10.5",
    "@sentry/tanstackstart-react": "10.73.0",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/router-plugin": "1.168.35",
    "@zidsa/zidmui": "3.3.1",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.2",
    "ky": "2.1.0",
    "notistack": "3.0.2",
    "posthog-js": "1.427.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.13",
    "react-query-kit": "3.3.4",
    "stylis": "4.4.0",
    "stylis-plugin-rtl": "2.1.1",
    "zod": "4.5.4",
    "srvx": "1.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "lefthook": "2.1.12",
    "msw": "2.15.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "prettier-plugin-sort-json": "4.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "bun": ">=1.4.1",
    "npm": "Please use bun"
  }
}
