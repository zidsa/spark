{
  "name": "@zidsa/spark",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun --env-file .env.local --preload ./instrument.server.mjs ./node_modules/.bin/vite dev --port 3000",
    "build": "vite build && cp instrument.server.mjs dist/server/",
    "preview": "vite preview",
    "start": "bun --preload ./dist/server/instrument.server.mjs dist/server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:eslint": "eslint .",
    "lint:eslint-fix": "eslint --fix .",
    "lint:prettier-check": "prettier --check .",
    "lint:prettier-fix": "prettier --write .",
    "tscheck": "tsc --noEmit"
  },
